  <div class="menu-section__inner">

    <header class="menu-section__head reveal reveal--d1">
      <span class="menu-section__eyebrow">03 &middot; Dessert</span>
      <h2 class="menu-section__title" id="dessert-title">To <em>finish.</em></h2>

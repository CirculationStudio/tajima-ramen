    <div class="bento bento--dessert">
      {%- for dish in dessert %}
      <article class="dish dish--quiet reveal reveal--d1">
        <div class="dish__body">
          <div class="dish__head">
            <span class="dish__price">${{ dish.price }}</span>
          </div>
          <h3 class="dish__name">{{ dish.name }}</h3>
          {%- if dish.description %}
          <p class="dish__desc">{{ dish.description }}</p>
          {%- endif %}
        </div>
      </article>
      {%- endfor %}
    </div>

  </div>
</section>


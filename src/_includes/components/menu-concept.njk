{# ===========================================================================
   Component: menu-concept

   The shared body of the two internal menu concepts. One file, because the
   whole point of the exercise is a like-for-like comparison: if the two routes
   rendered from separate markup they could drift and the comparison would be
   of my typing rather than of the two designs.

   EXPECTS
     variant     "b2" (three columns) or "b1" (two columns plus preview pane)
     showPrices  boolean

   DATA. Rows come from menu.json through the `dishesFor` filter, scoped to
   east-village, which is the same filter /tajima-college-heights/ and the five
   stubs already use. Nothing is transcribed from the reference mockups.
   =========================================================================== #}
{%- set sections = [
  { key: "izakaya", label: "Izakaya" },
  { key: "ramen",   label: "Ramen" },
  { key: "dessert", label: "Dessert" }
] %}

{%- set evLoc = (locations.items | where("id", "east-village")) | first %}

<div class="mc__mast">
  <p class="mc__kicker">{{ evLoc.address.street }}, {{ evLoc.address.locality }}</p>
  <h1 class="mc__title">What comes out of <em>East Village.</em></h1>
  <p class="mc__note">This room's own list. Walk in, no reservations.</p>
</div>

{%- for section in sections %}
{%- set rows = menu.items | dishesFor("east-village", section.key) %}
{%- if rows | length %}
{%- set tone = menuConcepts.barTones[section.key] %}
{%- set ornament = menuConcepts.ornaments[section.key] %}

{#- The preview pane's featured dish: the first row in this section whose
    photograph carries reviewed alt in photos.json. Undefined collapses the
    pane rather than rendering an empty frame. -#}
{%- set featured = rows | firstWithReviewedPhoto %}

<section class="mc-band mc-band--{{ tone }}" aria-labelledby="mc-{{ section.key }}">
  <header class="mc-band__bar">
    <h2 class="mc-band__label" id="mc-{{ section.key }}">{{ section.label }}</h2>
  </header>

  <div class="mc-band__row">
    {#- The vertical colour bar running down the left. Decorative repetition of
        the heading above it, so it is hidden from assistive technology. -#}
    <div class="mc-band__spine" aria-hidden="true"><span>{{ section.label }}</span></div>

    <div class="mc-band__body">
      {%- if ornament %}
      <div class="mc-band__art" aria-hidden="true"><svg><use href="#i-{{ ornament }}"></use></svg></div>
      {%- endif %}

      {%- if section.key == "ramen" %}
      {#- The confirmed slogan, from site.json. The mockups print "Fresh
          noodles crafted daily", which is not the locked string. -#}
      <p class="mc-band__blurb">{{ site.slogan.before }}{{ site.slogan.emphasis }}</p>
      {%- endif %}

      <div class="mc-band__cols">
        <ul class="mc-lines">
          {%- for dish in rows %}
          <li class="mc-line">
            <p class="mc-line__head">
              <span class="mc-line__name">{{ dish.name }}</span>
              {%- for flag in menuConcepts.legend %}
                {%- if flag.flag in dish.dietary %}
              <span class="mc-mark mc-mark--{{ flag.flag }}" title="{{ flag.label }}">
                <span class="u-visually-hidden">{{ flag.label }}</span>
                <span aria-hidden="true">{{ flag.letter }}</span>
              </span>
                {%- endif %}
              {%- endfor %}
              {%- if showPrices %}<span class="mc-line__price">{{ dish.price }}</span>{% endif %}
            </p>
            {%- if dish.description %}
            <p class="mc-line__note">{{ dish.description }}</p>
            {%- endif %}
            {%- if dish.availabilityNote %}
            <p class="mc-line__where">{{ dish.availabilityNote }}</p>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>

        {%- if variant == "b1" and featured %}
        {#- The preview pane. Sticky on wide viewports, inline on narrow.
            Renders only for a section with a reviewed photograph. -#}
        <aside class="mc-pane" aria-label="{{ section.label }}, featured dish">
          <figure class="mc-pane__fig">
            <img class="mc-pane__img"
              src="{{ featured.photo.src }}"
              alt="{{ featured.photo.alt }}"
              loading="lazy" decoding="async"
              width="{{ featured.photo.width }}" height="{{ featured.photo.height }}">
            <figcaption class="mc-pane__cap">
              <span class="mc-pane__name">{{ featured.dish.name }}</span>
              <span class="mc-pane__where">Photographed at Convoy</span>
            </figcaption>
          </figure>
        </aside>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{%- endif %}
{%- endfor %}

<footer class="mc-foot">
  <h2 class="mc-foot__h">Marks</h2>
  <ul class="mc-legend">
    {%- for flag in menuConcepts.legend %}
    <li class="mc-legend__item">
      <span class="mc-mark mc-mark--{{ flag.flag }}" aria-hidden="true"><span>{{ flag.letter }}</span></span>
      <span><b>{{ flag.label }}.</b> {{ flag.note }}</span>
    </li>
    {%- endfor %}
  </ul>
  {#- Named rather than guessed at. menu.json has no field for any of these. -#}
  <p class="mc-foot__gap">
    Not yet in the data, so not marked on any dish:
    {{ menuConcepts.missingFlags | join(", ") }}. These need a value per dish before they can appear.
  </p>

  <div class="mc-foot__fine">
    {%- for line in menuConcepts.footer %}
    <p>{{ line }}</p>
    {%- endfor %}
  </div>
</footer>

{# ===========================================================================
   Component: loc (a location card in a bento cell)

   Everything comes from locations.json. Never hardcode a NAP value here.

   Hours are absent on purpose and there is no placeholder for them.
   CLIENT_FACTS.md flags every hours value as unverified and says do not
   publish hours the door does not honor. The reference concept printed
   "11:00 to 22:00" on every row; that was invented.
   =========================================================================== #}

{% macro card(loc, index, modifier) %}
<article class="cell loc loc--{{ modifier | default('std') }} reveal">
  {#- PREVIEW BRANCH: the card gains a photograph where the location has a
      curated hero. Gated, so Maui renders the card it always had rather than
      an empty frame. Decorative: the card's accessible name is the location
      name in the heading below, so this carries alt="" rather than repeating
      it. Lazy, because /locations/ shows seven of these below the fold. -#}
  {%- set cardPhoto = roomPhotos[loc.id].hero %}
  {%- if cardPhoto %}
  <figure class="loc__photo">
    <img src="{{ cardPhoto.src }}" alt="" loading="lazy" decoding="async"
         width="{{ cardPhoto.width }}" height="{{ cardPhoto.height }}">
  </figure>
  {%- endif %}
  <div>
    <div class="loc__top">
      {# One consistent mark rather than a different icon per room: assigning
         icons to locations would be arbitrary, and the shared bowl reads as a
         card-type marker. Same mark on the happy hour rows. #}
      <span class="mark mark--sm" aria-hidden="true"><svg><use href="#i-ramen-bowl"></use></svg></span>
      <span class="loc__no">&#8470;&nbsp;{{ "0" if index < 10 }}{{ index }}</span>
      {%- if loc.opened %}
      <span class="loc__since">Since {{ loc.opened }}</span>
      {%- else %}
      <span class="loc__since">{{ loc.neighborhood }}, Hawaii</span>
      {%- endif %}
    </div>
    <h3 class="loc__name">
      <a href="{{ loc.url }}">{{ loc.name }}{% if loc.descriptor %} <em>{{ loc.descriptor }}</em>{% endif %}</a>
    </h3>
    <p class="loc__hood">{{ loc.neighborhood }}</p>
  </div>

  <p class="loc__diff">{{ loc.summary }}</p>

  <address class="loc__meta">
    <span class="loc__addr">
      {{ loc.address.street }}, {{ loc.address.locality }}, {{ loc.address.region }} {{ loc.address.postalCode }}
    </span>
    {%- if loc.phone %}
    <a class="loc__phone" href="{{ loc.phone | telHref }}">{{ loc.phone }}</a>
    {%- endif %}
    {# Same filter, same data as every other Directions link on the site. #}
    <a class="loc__directions" href="{{ loc | mapsUrl }}" target="_blank" rel="noopener noreferrer">Directions<span class="u-visually-hidden"> to {{ loc.name }}, opens in a new tab</span>
      <svg width="11" height="11" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M5 1.5h7.5V9M12.5 1.5 5.5 8.5M9 12.5H1.5V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a class="loc__go" href="{{ loc.url }}">See the room
      <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </a>
  </address>
</article>
{% endmacro %}

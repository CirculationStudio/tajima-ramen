node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
_site/
dist/
.cache/
.11ty-vite/

# Tailwind CLI compiled output (generated by `npm run css` from src/css/app.css)
src/css/styles.css

# Note: public/ is a tracked SOURCE dir (Vite publicDir). It holds the
# Cloudflare _headers/_redirects, site.webmanifest, fonts, and favicons, and
# must be committed. It is intentionally NOT ignored.

# Environment variables
.env
.env.local
.env.production

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
.tmp/

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/

# OS files
Thumbs.db

# Brand reference PDFs.
# _reference/tajima-brand-guidelines-oct-2025.pdf is REQUIRED for brand work:
# page 18 is the Email Campaign application the starburst, black header bar and
# gold field come from, page 19 is the Website application the homepage hero
# composition follows, and page 21 is Merchandise. It is 12MB, so it lives in
# the shared drive rather than in git. Fetch it before doing design work that
# touches a colour field or a badge.
_reference/*.pdf
